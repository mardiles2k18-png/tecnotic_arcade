<?xml version="1.0" encoding="UTF-8"?>
<!--
Tema: es-theme-tecnotics (versión básica)
Para: Tecnotics Arcade sobre Batocera
Tipografías: Anton y Barlow (licencia SIL Open Font License, ver art/fonts)
-->
<theme defaultView="detailed">
  <formatVersion>7</formatVersion>

  <variables>
    <cian>6EC6D8</cian>
    <naranja>F18E19</naranja>
    <fondo>080B10</fondo>
    <panel>0F151C</panel>
    <textoClaro>E8EEF2</textoClaro>
    <textoSuave>8FA3AE</textoSuave>
    <fuenteTitulo>./art/fonts/Anton-Regular.ttf</fuenteTitulo>
    <fuenteTexto>./art/fonts/Barlow-Regular.ttf</fuenteTexto>
    <fuenteTextoFuerte>./art/fonts/Barlow-SemiBold.ttf</fuenteTextoFuerte>
  </variables>

  <!-- ============ Pantalla de carga de EmulationStation ============ -->
  <view name="splash">
    <splash name="splash">
      <backgroundColor>${fondo}FF</backgroundColor>
    </splash>
    <image name="background">
      <pos>0.5 0.5</pos>
      <origin>0.5 0.5</origin>
      <minSize>1 1</minSize>
      <path>./art/splash.png</path>
    </image>
    <image name="progressbar">
      <origin>0 0</origin>
      <pos>0.3 0.93</pos>
      <size>0.4 0.008</size>
      <color>1C2630FF</color>
      <colorEnd>1C2630FF</colorEnd>
      <roundCorners>0.5</roundCorners>
    </image>
    <image name="progressbar:active">
      <path>./art/white.png</path>
      <color>${cian}FF</color>
      <colorEnd>${naranja}FF</colorEnd>
      <gradientType>horizontal</gradientType>
    </image>
    <text name="label">
      <pos>0.5 0.965</pos>
      <origin>0.5 0.5</origin>
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.02</fontSize>
      <color>${textoSuave}FF</color>
    </text>
  </view>

  <!-- ============ Menús ============ -->
  <view name="menu">
    <menuBackground name="menubg">
      <color>${panel}F5</color>
      <scrollbarColor>${cian}40</scrollbarColor>
      <scrollbarSize>0.004</scrollbarSize>
      <scrollbarAlignment>innerright</scrollbarAlignment>
    </menuBackground>
    <menuText name="menutitle">
      <fontPath>${fuenteTitulo}</fontPath>
      <fontSize>0.04</fontSize>
      <color>${cian}</color>
    </menuText>
    <menuText name="menufooter">
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.02</fontSize>
      <color>${textoSuave}</color>
    </menuText>
    <menuText name="menutext">
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.028</fontSize>
      <color>${textoClaro}</color>
      <separatorColor>FFFFFF0A</separatorColor>
      <selectorColor>${naranja}</selectorColor>
      <selectedColor>0B0F14</selectedColor>
    </menuText>
    <menuTextSmall name="menutextsmall">
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.018</fontSize>
      <color>${textoSuave}</color>
    </menuTextSmall>
    <menuGroup name="menugroup">
      <fontPath>${fuenteTextoFuerte}</fontPath>
      <fontSize>0.02</fontSize>
      <color>${naranja}</color>
      <backgroundColor>00000000</backgroundColor>
      <lineSpacing>2.2</lineSpacing>
    </menuGroup>
    <menuGrid name="menugrid">
      <separatorColor>FFFFFF0A</separatorColor>
    </menuGrid>
  </view>

  <!-- ============ Barra de ayuda (botones) ============ -->
  <customView name="system,basic,detailed,grid,gamecarousel">
    <helpsystem name="help">
      <textColor>${textoSuave}</textColor>
      <iconColor>${cian}</iconColor>
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.028</fontSize>
    </helpsystem>
  </customView>

  <!-- ============ Vista de sistemas (menú principal) ============ -->
  <view name="system">
    <image name="background" extra="true">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./art/bg.png</path>
      <zIndex>1</zIndex>
    </image>

    <!-- Cabecera con la marca -->
    <image name="marcaLogo" extra="true">
      <path>./art/logo-horizontal.png</path>
      <pos>0.035 0.06</pos>
      <origin>0 0.5</origin>
      <maxSize>0.24 0.075</maxSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>30</zIndex>
    </image>
    <text name="marcaArcade" extra="true">
      <text>ARCADE</text>
      <pos>0.285 0.06</pos>
      <origin>0 0.5</origin>
      <size>0.3 0.07</size>
      <fontPath>${fuenteTitulo}</fontPath>
      <fontSize>0.05</fontSize>
      <color>${naranja}</color>
      <alignment>left</alignment>
      <zIndex>30</zIndex>
    </text>
    <image name="marcaLinea" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.12</pos>
      <size>1 0.004</size>
      <color>${cian}60</color>
      <colorEnd>${cian}00</colorEnd>
      <gradientType>horizontal</gradientType>
      <zIndex>30</zIndex>
    </image>

    <!-- Franja central donde se desplazan los sistemas -->
    <image name="franja" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.36</pos>
      <size>1 0.28</size>
      <color>${panel}D0</color>
      <zIndex>10</zIndex>
    </image>
    <image name="franjaLineaSup" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.36</pos>
      <size>1 0.004</size>
      <color>${cian}</color>
      <zIndex>11</zIndex>
    </image>
    <image name="franjaLineaInf" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.636</pos>
      <size>1 0.004</size>
      <color>${naranja}</color>
      <zIndex>11</zIndex>
    </image>

    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0 0.36</pos>
      <size>1 0.28</size>
      <color>00000000</color>
      <logoSize>0.26 0.17</logoSize>
      <logoScale>1.25</logoScale>
      <maxLogoCount>3</maxLogoCount>
      <zIndex>20</zIndex>
    </carousel>

    <!-- Si un sistema no tiene logo, se muestra su nombre con esta letra -->
    <text name="logoText">
      <fontPath>${fuenteTitulo}</fontPath>
      <fontSize>0.075</fontSize>
      <color>${cian}</color>
      <forceUppercase>true</forceUppercase>
    </text>

    <text name="systemInfo">
      <pos>0 0.66</pos>
      <size>1 0.06</size>
      <backgroundColor>00000000</backgroundColor>
      <fontPath>${fuenteTextoFuerte}</fontPath>
      <fontSize>0.03</fontSize>
      <color>${textoSuave}</color>
      <alignment>center</alignment>
    </text>
  </view>

  <!-- ============ Listas de juegos: partes comunes ============ -->
  <view name="basic, detailed, grid, gamecarousel">
    <image name="background" extra="true">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./art/bg.png</path>
      <zIndex>1</zIndex>
    </image>
    <image name="cabecera" extra="true">
      <path>./art/white.png</path>
      <pos>0 0</pos>
      <size>1 0.13</size>
      <color>${panel}E6</color>
      <zIndex>40</zIndex>
    </image>
    <image name="cabeceraLinea" extra="true">
      <path>./art/white.png</path>
      <pos>0 0.13</pos>
      <size>1 0.004</size>
      <color>${cian}</color>
      <colorEnd>${naranja}</colorEnd>
      <gradientType>horizontal</gradientType>
      <zIndex>41</zIndex>
    </image>
    <!-- Nombre del sistema (se usa si no hay imagen de logo) -->
    <text name="logoText">
      <pos>0.035 0.065</pos>
      <origin>0 0.5</origin>
      <size>0.6 0.09</size>
      <fontPath>${fuenteTitulo}</fontPath>
      <fontSize>0.055</fontSize>
      <color>${textoClaro}</color>
      <alignment>left</alignment>
      <forceUppercase>true</forceUppercase>
      <zIndex>50</zIndex>
    </text>
    <image name="logo">
      <pos>0.035 0.065</pos>
      <origin>0 0.5</origin>
      <maxSize>0.3 0.09</maxSize>
      <zIndex>50</zIndex>
    </image>
    <image name="marcaLogo" extra="true">
      <path>./art/logo-horizontal.png</path>
      <pos>0.965 0.065</pos>
      <origin>1 0.5</origin>
      <maxSize>0.17 0.06</maxSize>
      <linearSmooth>true</linearSmooth>
      <zIndex>50</zIndex>
    </image>
  </view>

  <!-- ============ Lista sencilla ============ -->
  <view name="basic">
    <textlist name="gamelist">
      <pos>0.06 0.17</pos>
      <size>0.88 0.72</size>
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.034</fontSize>
      <primaryColor>${textoClaro}</primaryColor>
      <secondaryColor>${cian}</secondaryColor>
      <selectorColor>${naranja}</selectorColor>
      <selectedColor>0B0F14</selectedColor>
      <alignment>left</alignment>
      <horizontalMargin>0.01</horizontalMargin>
      <forceUppercase>false</forceUppercase>
      <zIndex>20</zIndex>
    </textlist>
  </view>

  <!-- ============ Lista con detalles (vista principal) ============ -->
  <view name="detailed">
    <textlist name="gamelist">
      <pos>0.035 0.17</pos>
      <size>0.45 0.73</size>
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.032</fontSize>
      <primaryColor>${textoClaro}</primaryColor>
      <secondaryColor>${cian}</secondaryColor>
      <selectorColor>${naranja}</selectorColor>
      <selectedColor>0B0F14</selectedColor>
      <extraTextColor>${textoSuave}</extraTextColor>
      <alignment>left</alignment>
      <horizontalMargin>0.01</horizontalMargin>
      <forceUppercase>false</forceUppercase>
      <scrollbarColor>${cian}40</scrollbarColor>
      <scrollbarSize>0.004</scrollbarSize>
      <scrollbarAlignment>outerright</scrollbarAlignment>
      <zIndex>20</zIndex>
    </textlist>

    <image name="panelDetalle" extra="true">
      <path>./art/white.png</path>
      <pos>0.515 0.17</pos>
      <size>0.45 0.73</size>
      <color>${panel}C8</color>
      <zIndex>15</zIndex>
    </image>

    <image name="md_image">
      <pos>0.74 0.39</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.42 0.38</maxSize>
      <zIndex>30</zIndex>
    </image>
    <video name="md_video">
      <pos>0.74 0.39</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.42 0.38</maxSize>
      <delay>1.0</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <zIndex>31</zIndex>
    </video>
    <image name="md_marquee">
      <pos>1 1</pos>
      <size>0 0</size>
    </image>

    <!-- De momento solo se muestra la descripción; el resto de datos se oculta -->
    <text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount, md_developer, md_publisher, md_genre, md_players, md_playcount">
      <pos>1 1</pos>
      <size>0 0</size>
    </text>
    <datetime name="md_releasedate, md_lastplayed">
      <pos>1 1</pos>
      <size>0 0</size>
    </datetime>
    <rating name="md_rating">
      <pos>1 1</pos>
      <size>0 0</size>
    </rating>
    <text name="md_description">
      <pos>0.53 0.62</pos>
      <size>0.42 0.26</size>
      <fontPath>${fuenteTexto}</fontPath>
      <fontSize>0.024</fontSize>
      <color>${textoClaro}</color>
      <alignment>left</alignment>
      <zIndex>30</zIndex>
    </text>
  </view>

  <!-- ============ Cuadrícula ============ -->
  <view name="grid">
    <imagegrid name="gamegrid">
      <pos>0.035 0.17</pos>
      <size>0.93 0.73</size>
      <margin>0.012 0.02</margin>
      <zIndex>20</zIndex>
    </imagegrid>
    <gridtile name="default">
      <backgroundColor>${panel}C8</backgroundColor>
      <padding>0.008 0.008</padding>
    </gridtile>
    <gridtile name="selected">
      <backgroundColor>${naranja}FF</backgroundColor>
    </gridtile>
    <text name="md_name">
      <pos>0.035 0.92</pos>
      <size>0.93 0.04</size>
      <fontPath>${fuenteTextoFuerte}</fontPath>
      <fontSize>0.03</fontSize>
      <color>${cian}</color>
      <alignment>center</alignment>
      <zIndex>30</zIndex>
    </text>
  </view>
</theme>
